	<array>
		<dict>
			<key>pfm_require</key>
			<string>always</string>
			<key>pfm_target_conditions</key>
			<array>
				<dict>
					<key>pfm_target</key>
					<string>Enabled</string>
					<key>pfm_present</key>
					<true/>
				</dict>
			</array>
		</dict>
	</array>
	<key>pfm_exclude</key>
